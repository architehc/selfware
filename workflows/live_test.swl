version: "1.0"
name: live_test

agents:
  tester:
    model: txn545/Qwen3.5-122B-A10B-NVFP4
    role: Test agent
    instruction: Say "Hello from 122B model" and nothing else
    tools: []

workflows:
  main:
    type: sequential

guardrails:
  - name: short_response
    type: post_agent
    condition: "agent_output.length < 100"
    on_violation: warn

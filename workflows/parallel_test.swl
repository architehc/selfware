version: "1.0"
name: parallel_visual_test
description: Test parallel agent execution

agents:
  poet:
    model: txn545/Qwen3.5-122B-A10B-NVFP4
    role: Poet
    instruction: Write a 2-line poem about coding
    
  summarizer:
    model: txn545/Qwen3.5-122B-A10B-NVFP4
    role: Summarizer  
    instruction: Summarize "SWL is a workflow language" in 5 words

workflows:
  parallel_demo:
    type: parallel
    steps:
      - delegate: poet
      - delegate: summarizer

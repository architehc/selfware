version: "1.0"
name: visual_test
description: |
  Visual test of SWL runtime with telemetry display

agents:
  greeter:
    model: txn545/Qwen3.5-122B-A10B-NVFP4
    role: A friendly assistant
    instruction: |
      Say exactly: "Hello! I am the txn545/Qwen3.5-122B-A10B-NVFP4 model running via SWL."
      Then add one interesting fact about programming.
      Keep it under 100 words.
    tools: []
    output_key: greeting

workflows:
  hello:
    type: sequential
    steps:
      - delegate: greeter

telemetry:
  enabled: true
  metrics:
    - inference_latency
    - token_usage

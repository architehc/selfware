# Git
.git
.gitignore
.gitattributes

# Build artifacts
target/
# ...but keep the prebuilt binary that Dockerfile.selfware copies in
# (`COPY target/release/selfware`); without this exception that COPY fails.
!target/release/selfware
# Playwright runtime deps are installed in-image; never ship the host's.
scripts/node_modules/
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation (keep README.md)
docs/
kimi_docs/
*.md
!README.md
!QUICKSTART.md


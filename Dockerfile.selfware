# Selfware Docker Image - CLI toolbox image using a pre-built binary

FROM ubuntu:24.04

# Prevent interactive prompts during apt
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    libsqlite3-0 \
    libfontconfig1 \
    libdbus-1-3 \
    ca-certificates \
    python3 \
    python3-pip \
    git \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Node runtime + Playwright for PageControl. The bridge is a NODE script
# (its embedded copy is extracted to ~/.selfware/bridge at runtime) and
# requires the Node `playwright` package, not the Python one.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm && \
    npm install -g playwright && \
    npx playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*
# Let the extracted bridge resolve the globally-installed playwright package.
ENV SELFWARE_PLAYWRIGHT_NODE_PATH=/usr/local/lib/node_modules

# Copy pre-built binary from host
COPY target/release/selfware /usr/local/bin/selfware

# Create working directory
WORKDIR /workspace

# Create config directory
RUN mkdir -p /root/.config/selfware

# Copy default config
COPY selfware-stress-test.toml /root/.config/selfware/config.toml

# Set environment variables for local vLLM endpoint
ENV SELFWARE_ENDPOINT=http://host.docker.internal:8000/v1
ENV SELFWARE_MODEL=qwen3.5-27b
ENV SELFWARE_MAX_TOKENS=131072
ENV RUST_LOG=info

# Entry point
ENTRYPOINT ["selfware"]
CMD ["--help"]

{
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer", "selfware"],
      "document_symbols": "on",
      "document_folding_ranges": "on"
    }
  },
  "language_models": {
    "openai_compatible": {
      "Selfware": {
        "api_url": "http://127.0.0.1:8000/v1",
        "available_models": [
          {
            "name": "Qwen/Qwen3-Coder-Next-FP8",
            "display_name": "Qwen3 Coder Next FP8",
            "max_tokens": 262144,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          }
        ]
      }
    }
  },
  "context_servers": {
    "Selfware": {
      "command": "/home/ivo/selfware/.zed/selfware-mcp-wrapper.sh",
      "args": ["mcp-server"],
      "env": {
        "SELFWARE_ENDPOINT": "http://127.0.0.1:8000/v1",
        "SELFWARE_MODEL": "Qwen/Qwen3-Coder-Next-FP8",
        "NO_COLOR": "1",
        "RUST_LOG": "error"
      }
    },
    "selfware": {
      "command": {
        "path": "/home/ivo/selfware/.zed/selfware-mcp-wrapper.sh",
        "arguments": ["mcp-server"],
        "env": {
          "SELFWARE_ENDPOINT": "http://127.0.0.1:8000/v1",
          "SELFWARE_MODEL": "Qwen/Qwen3-Coder-Next-FP8",
          "NO_COLOR": "1",
          "RUST_LOG": "error"
        }
      },
      "settings": {
        "endpoint": "http://127.0.0.1:8000/v1",
        "model": "Qwen/Qwen3-Coder-Next-FP8",
        "binary_path": "/home/ivo/selfware/target/debug/selfware"
      }
    }
  },
  "lsp": {
    "selfware": {
      "settings": {
        "endpoint": "http://127.0.0.1:8000/v1",
        "model": "Qwen/Qwen3-Coder-Next-FP8",
        "binary_path": "/home/ivo/selfware/target/debug/selfware"
      }
    }
  }
}
